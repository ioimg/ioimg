# ioimg runtime configuration.
# Copy to .env and load it in your process manager (docker compose reads .env
# automatically for variable substitution, not for the container env; see
# compose.yml for the demo).

# --- HTTP ---------------------------------------------------------------
IOIMG_ADDR=:8080
IOIMG_BASE_URL=https://img.example.com
IOIMG_LOG_LEVEL=info
IOIMG_LOG_FORMAT=json
IOIMG_ACCESS_LOG=false

# --- Security -----------------------------------------------------------
# Comma separated exact hosts or wildcards: cdn.example.com,*.example.com
IOIMG_ALLOWLIST=
# Open mode is a conscious opt-in. Prefer an allowlist in production.
IOIMG_ALLOW_ANY_HOST=false
# Allow origins on private/loopback/metadata addresses. Dev only.
IOIMG_ALLOW_PRIVATE=false
# Require a valid HMAC signature for every image request.
IOIMG_SIGNED_ONLY=true
# kid:secret[,oldkid:secret] — first key signs, all keys verify. Every key also
# derives an es_ source-encryption key via HKDF-SHA256 (info ioimg-source-enc-v1),
# so URL sources can be sealed and old tokens survive a key rotation.
IOIMG_SIGNING_KEYS=demo:change-me
IOIMG_SIGNATURE_INCLUDE_EXP=true
IOIMG_SIGNATURE_EXPIRY_REQUIRED=true
IOIMG_FALLBACK_REDIRECT=false

# --- Sources ------------------------------------------------------------
IOIMG_SOURCE_TIMEOUT=15s
# raw_ pass-through skips decode and resolution limits, but the body is still
# buffered in memory. 0 = 4x IOIMG_SOURCE_MAX_BYTES, minimum 64 MiB.
IOIMG_SOURCE_RAW_MAX_BYTES=0
IOIMG_SOURCE_MAX_BYTES=26214400
IOIMG_SOURCE_USER_AGENT=ioimg/0.1 (+https://ioimg.net)
# Upstream authorization, comma separated exact host=Header:Value. No wildcards
# or suffix matching. The value may contain spaces and colons after the first
# colon. Applied only to the exact host and never on a cross-host redirect.
# IOIMG_SOURCE_AUTH=cdn.example.com=Authorization:Bearer abc,api.example.com=X-Api-Key:secret
IOIMG_SOURCE_AUTH=
# Request header names copied to the upstream, comma separated. Values with
# CR/LF or over 1 KiB are dropped, and no listed header crosses a redirect to a
# different host. Authorization/Cookie are forwarded only when explicitly listed.
IOIMG_PASSTHROUGH_HEADERS=
# Extra headers added to image responses, comma separated Name:Value. Names must
# be RFC 7230 tokens; CR/LF in a value fails startup. Built-in headers win on a
# name collision. Cookie pass-through is intentionally unsupported.
IOIMG_RESPONSE_HEADERS=
IOIMG_MAX_DIMENSION=8192
# 0 = NumCPU*4
IOIMG_CONCURRENCY=0

# --- L1 cache -----------------------------------------------------------
IOIMG_CACHE_DIR=/var/cache/ioimg
IOIMG_CACHE_MAX_MB=4096

# --- Control plane (multi-tenant mode) -----------------------------------
# When IOIMG_CONTROL_URL is set, tenant config is pulled from the control plane
# instead of IOIMG_SIGNING_KEYS/IOIMG_ALLOWLIST/IOIMG_PRESETS.
IOIMG_CONTROL_URL=
IOIMG_CONTROL_TOKEN=
IOIMG_CONTROL_SYNC=30s
IOIMG_CONTROL_TIMEOUT=5s
# Dev only: allow X-IOIMG-Project to select a tenant (bypasses Host mapping).
IOIMG_ALLOW_PROJECT_HEADER=false
IOIMG_PROJECT_HEADER=X-IOIMG-Project

# --- L2 shared cache (S3/R2/MinIO/GCS-S3) --------------------------------
IOIMG_L2_ENABLED=false
IOIMG_L2_ENDPOINT=https://s3.example.com
IOIMG_L2_BUCKET=ioimg
IOIMG_L2_ACCESS_KEY=
IOIMG_L2_SECRET_KEY=
# Leave empty for the provider default (MinIO/R2 auto, S3 requires a region).
IOIMG_L2_REGION=
IOIMG_L2_PREFIX=ioimg
IOIMG_L2_USE_SSL=true
IOIMG_L2_TIMEOUT=10s

# --- CDN purge fan-out (best effort) -------------------------------------
# IOIMG_CDN_PROVIDERS=cloudflare,bunny,fastly
IOIMG_CDN_PROVIDERS=
IOIMG_CDN_CLOUDFLARE_TOKEN=
IOIMG_CDN_CLOUDFLARE_ZONE=
IOIMG_CDN_BUNNY_KEY=
IOIMG_CDN_FASTLY_TOKEN=
IOIMG_CDN_FASTLY_SERVICE=

# --- Transform limits ---------------------------------------------------
IOIMG_DISABLE_AVIF=false
# Encoder for AVIF output: auto (libavif when compiled in with -tags libavif),
# libavif, or vips. libvips' heifsave hides libaom's cpu-used behind a coarse
# "effort" knob, so the same bytes cost ~4x the CPU there.
IOIMG_AVIF_ENCODER=auto
# libaom cpu-used (0 slowest .. 10 fastest) for the libavif path. Measured on a
# 512px thumbnail at q65: speed 8 = 47 ms / 37.7 KB, speed 9 = 12.7 ms / 38.2 KB.
IOIMG_AVIF_SPEED=9
# libvips heifsave effort (0-9), used only when IOIMG_AVIF_ENCODER=vips or the
# binary lacks libavif. On this stack effort 1 is the fastest useful setting:
# effort 4 costs ~3x the time and effort 9 ~40x, with no size benefit.
IOIMG_AVIF_EFFORT=1
# Progressive (interlaced) JPEG: ~7% smaller files, ~20% slower encode.
IOIMG_JPEG_PROGRESSIVE=false
# Run the transform on its own goroutine instead of the request goroutine.
# celeris pins workers to one core; leaving this on keeps libvips' decode and
# encode threads on separate cores (a 512px PNG went from 69 to 51 ms).
IOIMG_OFFLOAD=true
# celeris io_uring worker count (min 2). Unset = GOMAXPROCS.
IOIMG_CELERIS_WORKERS=
IOIMG_DISABLE_WEBP=false

# --- Ops ----------------------------------------------------------------
IOIMG_PRESETS={"thumb":"h_320,c_fill,f_auto,q_auto","hero":"w_1600,c_fill,f_auto,q_80"}

# --- Admin / metrics ----------------------------------------------------
IOIMG_METRICS_TOKEN=
IOIMG_ADMIN_TOKEN=
IOIMG_TRUST_PROXY=false
IOIMG_RATE_RPS=0
IOIMG_RATE_BURST=0
